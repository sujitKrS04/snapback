# LiveKit Room Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram ASR Credentials
DEEPGRAM_API_KEY=your_deepgram_api_key
# Optional: DEEPGRAM_MODEL (defaults to nova-3)
DEEPGRAM_MODEL=nova-3

# TTS Provider Configuration
# Supported options: rime (default), deepgram
TTS_PROVIDER=rime
TTS_FALLBACK_PROVIDER=deepgram

# Rime TTS Credentials (used when TTS_PROVIDER=rime)
RIME_API_KEY=your_rime_api_key
# Optional Rime settings
RIME_MODEL=coda
RIME_VOICE=celeste

# Logging Configuration
# Target structured JSON lines log path (defaults to logs/agent.log)
LOG_FILE_PATH=logs/agent.log

# FastAPI Backend Configuration
BACKEND_PORT=8000
CHECK_AVAILABILITY_DELAY=4.0
BACKEND_LOG_PATH=logs/backend.log

# LLM Orchestration (OpenAI-compatible)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
